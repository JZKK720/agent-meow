# agent-meow all-in-one .env example
# Copy to .env and edit as needed: cp .env.all-in-one .env

# ── Database ──────────────────────────────────────────────────────
POSTGRES_DB=agentmeow
POSTGRES_USER=agentmeow
POSTGRES_PASSWORD=agentmeow-dev

# ── agent-meow image ───────────────────────────────────────────────
# Use prebuilt GHCR image (recommended) or build locally with --build
AGENT_MEOW_IMAGE=ghcr.io/jzkk720/agent-meow-server
# Host runner uses its own target/image; override only if you publish a custom host image.
# AGENT_MEOW_HOST_IMAGE=ghcr.io/jzkk720/agent-meow-host
AGENT_MEOW_IMAGE_TAG=latest

# ── Hermes gateway ────────────────────────────────────────────────
# API key for Hermes gateway — change to your own random string for production
HERMES_API_KEY=demo-key-change-me

# ── Media & Generation (optional) ─────────────────────────────────
# Set these to enable AI image/video generation, or configure via
# Settings → Media & Generation in the web UI after startup.

# DashScope (阿里云百炼 万相) — image + video generation
# Get key at: https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=

# fal.ai — image + video generation (flux models)
# Get key at: https://fal.ai/dashboard/keys
FAL_KEY=

# Image generation provider: none | dashscope | fal | a1111 | hosted
IMAGE_GEN_PROVIDER=

# Video generation provider: none | dashscope | fal | hyperframes | pixelle
VIDEO_GEN_PROVIDER=

# ── Ollama ────────────────────────────────────────────────────────
# The quickstart compose includes an Ollama container (stock image,
# starts empty). The ollama-init one-shot service pulls the default
# model chain on first boot so chat works out of the box:
#   deepseek-v4-flash:0731-cloud (cloud, no download) + qwen3.5:9b-q8_0 (local)
# Override with a comma-separated list (or empty to skip pulling):
OLLAMA_PULL_MODELS=deepseek-v4-flash:0731-cloud,qwen3.5:9b-q8_0

# Already have Ollama installed on your host with models pulled?
# Point Hermes at it instead of the container — no re-pull needed:
#   OLLAMA_BASE_URL=http://host.docker.internal:11434
# (On Linux, add `extra_hosts: ["host.docker.internal:host-gateway"]`
#  to the hermes-gateway service in a compose override file.)
OLLAMA_BASE_URL=

# How long Ollama keeps loaded models resident in memory after last use.
# Default is 5m; 30m prevents cold-start reload gaps in the voice pipeline.
# For containerized Ollama (default compose) this is applied automatically.
# For host-runtime Ollama (override path), run enable-ollama-keepalive.ps1
# once to set it persistently on the host OS.
OLLAMA_KEEP_ALIVE=30m

# ── Already running Hermes + Ollama? Use the override file ─────────
# If you already have Hermes + Ollama running on your host (e.g. your
# dev machine), drop docker-compose.override.yml next to docker-compose.yml
# to strip those services from this stack and point agent-meow at your
# existing instances instead. Set these only if using the override:
#   curl -sL https://raw.githubusercontent.com/JZKK720/agent-meow/main/deploy/docker/docker-compose.override.yaml -o docker-compose.override.yml
# EXISTING_HERMES_PORT=8642
# EXISTING_OLLAMA_PORT=11434
# EXISTING_QWEN_TTS_PORT=8889

# ── Qwen3-TTS (offline TTS) ───────────────────────────────────────
# The TTS server downloads the 0.6B model on first start (~2.3GB, ~5min).
# To skip the download, pre-download the model to a local directory and
# mount it as a volume:
#   volumes:
#     - /path/to/your/models:/models
#
# Model download (if not using Docker):
#   python scripts/download_qwen3_tts.py
#
# QWEN3_TTS_IMAGE=qwen3-tts
# QWEN3_TTS_TAG=latest