{
  "name": "agent-meow-desktop-electron",
  "productName": "agent-meow",
  "version": "0.7.9",
  "description": "agent-meow desktop shell (Electron edition) — a thin native wrapper around the server-served web UI.",
  "private": true,
  "main": "src/main.js",
  "homepage": "https://github.com/JZKK720/agent-meow",
  "repository": {
    "type": "git",
    "url": "https://github.com/JZKK720/agent-meow.git"
  },
  "author": {
    "name": "agent-meow",
    "email": "support@agent-meow.local"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "test": "node --test",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac",
    "build:mac:release": "electron-builder --mac -c.mac.notarize=true",
    "build:linux": "electron-builder --linux",
    "build:win": "electron-builder --win",
    "build:overlay": "npm --prefix ../ run build:overlay",
    "predev": "npm run build:overlay",
    "prestart": "npm run build:overlay",
    "prebuild": "npm run build:overlay && node build/embed_python.js",
    "prebuild:mac": "npm run build:overlay && node build/embed_python.js",
    "prebuild:mac:release": "npm run build:overlay && node build/embed_python.js",
    "prebuild:linux": "npm run build:overlay && node build/embed_python.js",
    "prebuild:win": "npm run build:overlay && node build/embed_python.js"
  },
  "devDependencies": {
    "electron": "^42.3.2",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "dev.agentmeow.desktop",
    "productName": "agent-meow",
    "directories": {
      "output": "dist"
    },
    "protocols": [
      {
        "name": "agent-meow session link",
        "schemes": [
          "agent-meow"
        ]
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "JZKK720",
        "repo": "agent-meow"
      }
    ],
    "afterPack": "build/afterPack.js",
    "files": [
      "src/**/*",
      "setup/**/*",
      "find/**/*",
      "icons/**/*",
      "overlay/**/*"
    ],
    "extraResources": [
      {
        "from": "../platform-assets",
        "to": "platform-assets",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "embedded-python",
        "to": "embedded-python",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "icons/icon.icns",
      "artifactName": "${productName}-${version}-${arch}-mac.${ext}",
      "identity": "Databricks, Inc. (8RMX4WU6F8)",
      "hardenedRuntime": true,
      "entitlements": "signing/entitlements.mac.plist",
      "entitlementsInherit": "signing/entitlements.mac.inherit.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Omnigent uses the microphone for voice dictation in the message composer.",
        "CFBundleIconName": "AppIcon"
      },
      "gatekeeperAssess": false,
      "notarize": false,
      "target": [
        "dmg",
        "zip"
      ],
      "publish": [
        {
          "provider": "github",
          "owner": "JZKK720",
          "repo": "agent-meow"
        }
      ]
    },
    "dmg": {
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "background": "dmg/background.tiff",
      "window": {
        "width": 640,
        "height": 465
      },
      "iconSize": 96,
      "contents": [
        {
          "x": 170,
          "y": 100
        },
        {
          "x": 470,
          "y": 100,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "linux": {
      "icon": "icons/icon.png",
      "category": "Development",
      "maintainer": "agent-meow <support@agent-meow.local>",
      "target": [
        "AppImage",
        "deb"
      ],
      "publish": [
        {
          "provider": "github",
          "owner": "JZKK720",
          "repo": "agent-meow"
        }
      ]
    },
    "win": {
      "icon": "icons/icon.ico",
      "target": [
        "nsis"
      ],
      "publish": [
        {
          "provider": "github",
          "owner": "JZKK720",
          "repo": "agent-meow"
        }
      ]
    },
    "nsis": {
      "include": "build/nsis-installer.nsh",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "runAfterFinish": true,
      "installerIcon": "icons/icon.ico",
      "uninstallerIcon": "icons/icon.ico",
      "installerHeaderIcon": "icons/icon.ico",
      "installerSidebar": "icons/installer-sidebar.bmp",
      "installerHeader": "icons/installer-header.bmp",
      "deleteAppDataOnUninstall": false,
      "displayLanguageSelector": false,
      "language": "1033",
      "shortcutName": "agent-meow"
    }
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "js-yaml": "^4.2.0"
  }
}
