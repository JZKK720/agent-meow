oid an infinite reload loop\r\n        // when the LoginPage itself calls resolveIdentity).\r\n        try {\r\n          const data = (await res.json()) as {\r\n            user_id: null;\r\n            login_url?: string;\r\n          };\r\n          if (data.login_url) {\r\n            _serverLoginUrl = data.login_url;\r\n            if (!_isOnLoginPath()) {\r\n              const returnTo = encodeURIComponent(\r\n                window.location.pathname + window.location.search,\r\n              );\r\n              window.location.href = `${data.login_url}?return_to=${returnTo}`;\r\n              return null;\r\n            }\r\n          }\r\n        } catch {\r\n          // Response body was not JSON \u2014 fall through.\r\n        }\r\n      }\r\n      if (res.ok) {\r\n        const data = (await res.json()) as {\r\n          user_id: string | null;\r\n          is_admin?: boolean;\r\n        };\r\n        _currentUserId = data.user_id;\r\n        _currentIsAdmin = data.is_admin ?? false;\r\n      }\r\n    } catch {\r\n      // Server unreachable \u2014 leave as null.\r\n    }\r\n    _resolved = true;\r\n    return _currentUserId;\r\n  })", "source_file": "C:\\Users\\1\\github-pr\\agent-meow\\web\\src\\lib\\identity.ts", "source_location": "L67"}, {"caller_nid": "identity_authenticatedfetch", "callee": "has", "source_file": "C:\\Users\\1\\github-pr\\agent-meow\\web\\src\\lib\\identity.ts", "source_location": "L152"}, {"caller_nid": "identity_authenticatedfetch", "callee": "set", "source_file": "C:\\Users\\1\\github-pr\\agent-meow\\web\\src\\lib\\identity.ts", "source_location": "L154"}, {"caller_nid": "identity_authenticatedfetch", "callee": "hostFetch", "source_file": "C:\\Users\\1\\github-pr\\agent-meow\\web\\src\\lib\\identity.ts", "source_location": "L162"}, {"caller_nid": "identity_authenticatedfetch", "callee": "toString", "source_file": "C:\\Users\\1\\github-pr\\agent-meow\\web\\src\\lib\\identity.ts", "source_location": "L162"}, {"caller_nid": "ident