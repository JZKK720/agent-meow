%% HX470 · 四引擎混合 offload 架构图
%% dGPU (CUDA) + iGPU (890M) + NPU + CPU with mixed memory
flowchart LR
  subgraph dGPU["dGPU · RTX 5060 (8GB GDDR7, CUDA)"]
    LLM_A["LLM 活跃层\n3B MoE\n~3 GB"]
    STT["STT\nQwen3-ASR-0.6B\n~2.5 GB"]
  end

  subgraph iGPU["iGPU · Radeon 890M"]
    MOE["MoE 专家 offload\n256 专家分布\nIQ3_XXS ~13GB"]
  end

  subgraph CPU["CPU · 12C/24T"]
    TTS["Kokoro TTS"]
    VAD["Silero VAD"]
    GW["QAA 网关 :3101"]
  end

  subgraph NPU["NPU · XDNA 2 (~50 TOPS)"]
    AUX["辅助推理\n未来 STT 卸载"]
  end

  subgraph RAM["统一内存 32GB DDR5-5600"]
    EXPERT["MoE 专家层\nIQ3_XXS ~13GB"]
  end

  dGPU ==>|CUDA 直连| LLM_A
  GW -->|离线| STT
  STT -->|文本| HERMES["Hermes :8642"]
  HERMES -->|prompt| LLM_A
  LLM_A -->|专家路由| MOE
  MOE -->|卸载| EXPERT
  LLM_A -->|回复| TTS
  TTS -->|音频| BROWSER["浏览器"]

  classDef dgpu fill:#f0f9ee,stroke:#2ea65c,stroke-width:2px,color:#1a1410
  classDef igpu fill:#eef4ff,stroke:#3b8ff5,stroke-width:1.5px,color:#1a1410
  classDef cpu fill:#fff8ec,stroke:#e8651a,stroke-width:1.5px,color:#1a1410
  classDef npu fill:#fef3e0,stroke:#d4972a,stroke-width:1.5px,color:#1a1410
  classDef ram fill:#f5f0ff,stroke:#8e99a4,stroke-width:1.5px,color:#1a1410

  class dGPU,LLM_A,STT dgpu
  class iGPU,MOE igpu
  class CPU,TTS,VAD,GW cpu
  class NPU,AUX npu
  class RAM,EXPERT ram