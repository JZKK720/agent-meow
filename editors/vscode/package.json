{
  "name": "agent-meow-vscode",
  "displayName": "agent-meow",
  "description": "Open your running local agent-meow server inside VS Code, in an editor-beside iframe.",
  "version": "0.1.0",
  "publisher": "databricks",
  "license": "Apache-2.0",
  "icon": "media/agent-meow-icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/JZKK720/agent-meow.git",
    "directory": "editors/vscode"
  },
  "engines": {
    "vscode": "^1.74.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "configuration": {
      "title": "agent-meow",
      "properties": {
        "agent_meow.serverUrl": {
          "type": "string",
          "default": "",
          "markdownDescription": "Manual agent-meow server URL override for a **localhost** server (e.g. `http://127.0.0.1:6767`). Leave empty to auto-discover a locally running agent-meow server. Non-localhost URLs are not supported in this build."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agent-meow-container",
          "title": "agent-meow",
          "icon": "media/agent-meow-icon.svg"
        }
      ]
    },
    "views": {
      "agent-meow-container": [
        {
          "type": "tree",
          "id": "agent_meow.home",
          "name": "agent-meow"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "agent_meow.home",
        "contents": "Open the running agent-meow server UI in an editor tab.\n[Open agent-meow](command:agent_meow.open)\nStart a local server with `meow server`, or set `agent_meow.serverUrl` to a localhost URL."
      }
    ],
    "commands": [
      {
        "command": "agent_meow.open",
        "title": "agent-meow: Open",
        "icon": "media/agent-meow-icon.svg"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "agent_meow.open",
          "group": "navigation@99"
        }
      ],
      "commandPalette": [
        {
          "command": "agent_meow.open"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.js",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.74.0",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.21.5",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
